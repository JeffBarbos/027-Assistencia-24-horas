# Cache para assets estáticos com versão/hash — 1 ano, imutável
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — sem cache (sempre buscar versão nova após deploy)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate
